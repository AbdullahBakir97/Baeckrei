# Copy to .env.local and adjust.

# Backend URL. Development defaults to http://localhost:8000; a production
# build talks to the site it is served from (see DEPLOY.md).
VITE_API_URL=http://localhost:8000

# Public address of the shop, used for canonical links and share previews
VITE_SITE_URL=https://www.example.de

# Optional: a Spline scene (.splinecode URL from Spline's "Export > Code")
# shown in the home page hero instead of the built-in 3D bakery scene.
VITE_SPLINE_SCENE=
