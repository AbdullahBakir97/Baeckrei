# HTTPS certificates are fetched and renewed automatically.
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# Uploaded photos and 3D models, straight from disk.
	handle_path /media/* {
		root * /data/media
		header Cache-Control "public, max-age=604800"
		file_server
	}

	# Everything else: the app (API, storefront pages and files).
	handle {
		reverse_proxy web:8000
	}
}
