# Copy to backend/.env for local development. Never commit the real .env.
DJANGO_DEBUG=True
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Where password reset links point to
FRONTEND_URL=http://localhost:5173
# Email: printed to the console unless EMAIL_HOST is set
DEFAULT_FROM_EMAIL=noreply@localhost
# Receives contact form messages
SHOP_NOTIFICATION_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Shop
SHOP_DELIVERY_FEE=3.50
SHOP_PAYPAL_ENABLED=False
