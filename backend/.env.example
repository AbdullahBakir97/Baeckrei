# Copy to backend/.env for local development. Never commit the real .env.
DJANGO_DEBUG=True
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Where password reset links point to
FRONTEND_URL=http://localhost:5173
# Email: printed to the console unless EMAIL_HOST is set
DEFAULT_FROM_EMAIL=noreply@localhost
# Receives new-order alerts and contact form messages
SHOP_NOTIFICATION_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Shop
SHOP_DELIVERY_FEE=3.50
SHOP_PAYPAL_ENABLED=False
# Pickup/delivery times offered at checkout. Days not listed are closed.
SHOP_OPENING_HOURS=mon-fri 07:00-18:00; sat 07:00-14:00; sun 08:00-12:00
SHOP_SLOT_MINUTES=30
SHOP_PICKUP_LEAD_MINUTES=60
SHOP_DELIVERY_LEAD_MINUTES=120
# Orders per time slot (0 = no limit)
SHOP_SLOT_CAPACITY=0

# Online payment with Stripe (test keys locally). See DEPLOY.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Search engines and share previews
# Shop details used in page titles and structured data
SHOP_NAME=Backlover
SHOP_STREET=Friedrichstraße
SHOP_CITY=Berlin
# Path to the built storefront (frontend/dist/index.html). When set, Django
# serves storefront pages with their titles and share tags filled in.
FRONTEND_INDEX_FILE=
# Where Django's own admin lives (the storefront uses /admin)
DJANGO_ADMIN_PATH=django-admin/
