# Copy to .env.production and fill it in. Put only SITE_DOMAIN (e.g.
# SITE_DOMAIN=backlover.de) in a file called .env next to
# docker-compose.yml. Never commit either file. See DEPLOY.md.

# Database (used by both the Postgres container and the app).
# Choose a long random password.
POSTGRES_DB=backlover
POSTGRES_USER=backlover
POSTGRES_PASSWORD=

DJANGO_DEBUG=False
# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
# Keep the Django admin at a hard-to-guess path.
DJANGO_ADMIN_PATH=django-admin/
# One year of HSTS once HTTPS works for the whole domain.
DJANGO_SECURE_HSTS_SECONDS=31536000

SHOP_NAME=Backlover
SHOP_STREET=Friedrichstraße
SHOP_CITY=Berlin
SHOP_DELIVERY_FEE=3.50
# Pickup/delivery times offered at checkout. Days not listed are closed.
SHOP_OPENING_HOURS=mon-fri 07:00-18:00; sat 07:00-14:00; sun 08:00-12:00
SHOP_SLOT_MINUTES=30
SHOP_PICKUP_LEAD_MINUTES=60
SHOP_DELIVERY_LEAD_MINUTES=120
# Orders per time slot (0 = no limit)
SHOP_SLOT_CAPACITY=0

# Email (order confirmations, password reset, contact form)
DEFAULT_FROM_EMAIL=Backlover <bestellung@backlover.de>
# Receives new-order alerts and contact form messages
SHOP_NOTIFICATION_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Online payment (Stripe). Leave empty to offer only cash/card on pickup.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Error reports (optional)
SENTRY_DSN=

# Uploads in an S3-compatible bucket instead of the server disk (optional)
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
